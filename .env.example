# Contact form (Resend) — https://resend.com
# API key from your Resend dashboard.
RESEND_API_KEY=

# Sender address. Must be on a domain verified in Resend (e.g. regenera.bio).
CONTACT_FROM_EMAIL="Regenera Advisory <no-reply@regenera.bio>"

# Where contact form submissions are delivered. Defaults to info@regenera.bio if unset.
CONTACT_TO_EMAIL=info@regenera.bio

# Field Notes subscribe form (Buttondown) — https://buttondown.email
BUTTONDOWN_API_KEY=

# Supabase (persists contact + subscribe form submissions; no auth used)
# Public by design: NEXT_PUBLIC_ vars are exposed to the browser, and the
# publishable key only allows what RLS policies grant to the anon role
# (insert-only on contact_submissions / subscribers, no reads).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service role key. SERVER-SIDE ONLY, never prefixed NEXT_PUBLIC_,
# never sent to the browser. Used for: (1) the one-way public-form-to-CRM
# ingestion path (lib/crm/ingest.ts), (2) the intelligence-system collector
# route (app/api/intel/collect), and (3) nothing else. Every CRM/intel table
# is otherwise gated by RLS to authenticated, active `staff` rows only, see
# docs/crm/SECURITY_MODEL.md.
SUPABASE_SERVICE_ROLE_KEY=

# Intelligence OS collector route (app/api/intel/collect). Shared secret a
# scheduler (Supabase pg_cron + pg_net, or a GitHub Actions cron job) sends
# in an x-collector-secret header, since a scheduled job has no staff login
# session. Generate a random value, e.g. `openssl rand -hex 32`.
INTEL_COLLECTOR_SECRET=

# Investor Intelligence domain (docs/intelligence-system/INVESTOR_INTELLIGENCE.md).
# Fully optional -- the module works with zero of these set, using the
# always-available ManualUrlProvider only.

# Jina Reader (https://jina.ai/reader). Optional: works with no key at a low
# free rate limit; set this to raise that limit. Never required.
JINA_API_KEY=

# Agent Reach (https://github.com/Panniantong/agent-reach) is NOT an env var
# -- it's an external CLI this application detects via `agent-reach doctor
# --json` but never installs on its own. See INVESTOR_INTELLIGENCE.md
# section 5 before installing it, especially before enabling its LinkedIn
# channel (real ToS/legal exposure, requires a deliberate decision, not just
# a working connection).
