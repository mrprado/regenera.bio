# Contact form (Resend) — https://resend.com
# API key from your Resend dashboard.
RESEND_API_KEY=

# Sender address. Must be on a domain verified in Resend (e.g. regenera.bio).
CONTACT_FROM_EMAIL="Regenera Advisory <no-reply@regenera.bio>"

# Where contact form submissions are delivered. Defaults to info@regenera.bio if unset.
CONTACT_TO_EMAIL=info@regenera.bio

# Field Notes subscribe form (Buttondown) — https://buttondown.email
BUTTONDOWN_API_KEY=

# Supabase (persists contact + subscribe form submissions; no auth used)
# Public by design: NEXT_PUBLIC_ vars are exposed to the browser, and the
# publishable key only allows what RLS policies grant to the anon role
# (insert-only on contact_submissions / subscribers, no reads).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service role key. SERVER-SIDE ONLY, never prefixed NEXT_PUBLIC_,
# never sent to the browser. Used only for two things: (1) the one-way
# public-form-to-CRM ingestion path (lib/crm/ingest.ts), and (2) nothing
# else. Every CRM table is otherwise gated by RLS to authenticated, active
# `staff` rows only, see docs/crm/SECURITY_MODEL.md.
SUPABASE_SERVICE_ROLE_KEY=
